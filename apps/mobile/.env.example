# apps/mobile — cópia local: `cp apps/mobile/.env.example apps/mobile/.env`
#
# Expo só expõe ao bundle do cliente variáveis prefixadas EXPO_PUBLIC_ — nunca coloque um segredo
# real (service role key, client secret) aqui; esses ficam só do lado do servidor (apps/web) ou
# em variáveis de ambiente do EAS Build/Submit (Fase 10, não neste arquivo).

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_SITE_URL=http://localhost:3000
