# apps/web — cópia local: `cp apps/web/.env.example apps/web/.env.local`
#
# Lista completa e comentada em ../../.env.example (raiz do monorepo) — este arquivo é só o
# subconjunto que apps/web de fato lê, na convenção que o Next.js espera (.env.local, não
# versionado).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

OPENAI_API_KEY=
OPENAI_PLAN_MODEL=gpt-5.6

SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
EXECUTAR_APP_ENV=development
