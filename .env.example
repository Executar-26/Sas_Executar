# EXECUTAR SaaS — variáveis de ambiente (referência canônica)
#
# Este arquivo documenta TODA variável que o projeto vai precisar ao longo das fases do plano
# (docs/PLAN.md §5), não só as que já têm código para consumi-las hoje. Nada aqui tem valor real
# — copie para .env.local (apps/web) / .env (apps/mobile) e preencha localmente; nunca commite o
# arquivo preenchido (.gitignore já cobre .env* fora deste .example).
#
# Convenção: variáveis prefixadas NEXT_PUBLIC_ (web) ou EXPO_PUBLIC_ (mobile) vão para o bundle
# do cliente — nunca coloque segredo real nelas. Tudo sem esse prefixo é server-only.

# ---------------------------------------------------------------------------------------------
# Supabase (Fase 1) — Auth, Postgres/RLS, Storage
# ---------------------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------------------------
# Auth social (Fase 1) — Google + Sign in with Apple, decisão travada no plano (docs/PLAN.md §4)
# Configurados no provedor OAuth do Supabase; os client_id/secret abaixo são os mesmos usados em
# supabase/config.toml via env(...).
# ---------------------------------------------------------------------------------------------
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=
SUPABASE_AUTH_APPLE_CLIENT_ID=
SUPABASE_AUTH_APPLE_SECRET=

# ---------------------------------------------------------------------------------------------
# Stripe (Fase 5) — billing por team
# ---------------------------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------------------------
# Gerador de plano por IA (Fase 2/3) — decisão travada: mantém OpenAI (docs/PLAN.md, Contexto)
# ---------------------------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_PLAN_MODEL=gpt-5.6

# ---------------------------------------------------------------------------------------------
# Observabilidade (Fase 0) — escolher Sentry OU @vercel/otel antes de preencher; não deixar as
# duas seções pela metade em produção, é uma decisão a tomar na Fase 0, não uma dupla integração.
# ---------------------------------------------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ---------------------------------------------------------------------------------------------
# Rate limiting distribuído (Fase 0) — substitui o padrão em-memória do AppScanner original
# (achado F-009 da auditoria), aplicado a toda rota mutante, não só uma.
# ---------------------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------------------------
# App (todas as fases)
# ---------------------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
EXECUTAR_APP_ENV=development
